      {
        "name": "Python",
        "type": "ExecutePythonScript",
        "version": "1.0.6",
        "actionId": "0d8a7140-06fe-4c9c-95e0-77ca1ea3c9ca",
        "actionDefinitionActionId": "269d731f-0848-4d97-adb7-c64ac01cad48",
        "disabled": false,
        "created": "0001-01-01T00:00:00Z",
        "updated": "0001-01-01T00:00:00Z",
        "isDeactivated": false,
        "parameters": [
          {
            "key": "command-chip",
            "type": "Boolean",
            "value": "false"
          },
          {
            "key": "inputParams",
            "type": "Array",
            "value": "[{\u0022key\u0022:\u0022Versions\u0022,\u0022type\u0022:\u0022Array\u0022,\u0022value\u0022:\u0022$$Versions$$\u0022}]"
          },
          {
            "key": "command",
            "type": "String",
            "value": "\u0022def compare_versions(version1, version2):\\r\\n    v1_parts = version1.split(\u0027.\u0027)\\r\\n    v2_parts = version2.split(\u0027.\u0027)\\r\\n    for i in range(3):\\r\\n        if int(v1_parts[i]) \u003C int(v2_parts[i]):\\r\\n            return -1\\r\\n        elif int(v1_parts[i]) \u003E int(v2_parts[i]):\\r\\n            return 1\\r\\n    return 0\\r\\ndef highest_semantic_version(versions):\\r\\n    \\\u0022\\\u0022\\\u0022\\r\\n    Function to find the highest semantic version from a list of versions.\\r\\n    \\\u0022\\\u0022\\\u0022\\r\\n    if not versions:\\r\\n        return None\\r\\n    highest_version = versions[0]\\r\\n    for version in versions[1:]:\\r\\n        if compare_versions(version, highest_version) == 1:\\r\\n            highest_version = version\\r\\n    return highest_version\\r\\nversions = list(context[\\\u0022Versions\\\u0022])\\r\\nprint(highest_semantic_version(versions))\u0022"
          },
          {
            "key": "tempContext",
            "type": "Boolean",
            "value": "false"
          },
          {
            "key": "timeout",
            "type": "Number",
            "value": "30000"
          },
          {
            "key": "errorOnTimeout",
            "type": "Boolean",
            "value": "false"
          },
          {
            "key": "failOnError",
            "type": "Boolean",
            "value": "true"
          }
        ],
